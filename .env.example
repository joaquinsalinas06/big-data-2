# ==========================================
# Configuración de Neo4j
# ==========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia-esta-clave-local
NEO4J_DATABASE=neo4j

# ==========================================
# Configuración de Cassandra
# ==========================================
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=music_dna

# ==========================================
# Configuración de MongoDB
# ==========================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=listenbrainz_db
MONGO_COLLECTION=listens

# ==========================================
# Configuración de Airflow (docker compose)
# ==========================================
# Dentro de los contenedores las bases se alcanzan por nombre de servicio; el
# docker-compose.yml ya fija esos hosts y aquí solo se leen claves y nombres.
# En Linux conviene poner el uid propio (id -u) para que los logs no queden de root.
AIRFLOW_UID=50000
